# Spyglass Matrix — AI generation (server-side only)
#
# The Matrix Builder calls the Anthropic API from a Next.js server route so the
# job description + private meeting notes never leave the server and the key is
# never exposed to the browser. When ANTHROPIC_API_KEY is unset, the app falls
# back to the bundled static sample Matrix — everything still works for a demo.

# Your Anthropic API key (keep this secret; never commit a real key).
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-sonnet-4-6 (fast + capable for structured JSON).
# Use claude-opus-4-8 for the most capable generation.
ANTHROPIC_MODEL=claude-sonnet-4-6

# ---- Recruiter workroom ----------------------------------------
# The shared code recruiters type at /workroom to unlock it. Anyone
# with this code can read internal search strategy, so set your own
# and rotate it when someone leaves. Falls back to OLLIN-WORKROOM.
WORKROOM_ACCESS_CODE=

# Signs the workroom pass and the login session. Set a long random
# value in production; changing it logs everyone out.
AUTH_SECRET=
